# CockroachDB Cloud connection (pgwire). From the Cloud console:
#   Cluster > Connect > "General connection string".
# CockroachDB is Postgres-wire-compatible, so any psycopg/libpq URL works.
# A local `cockroach start-single-node` URL works identically for dev.
COCKROACH_URL=postgresql://<user>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full

# AWS Bedrock vars (embeddings + reasoning) are added when embed.py lands.
