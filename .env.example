# CockroachDB Cloud connection (pgwire). From the Cloud console:
#   Cluster > Connect > "General connection string".
# CockroachDB is Postgres-wire-compatible, so any psycopg/libpq URL works.
# A local `cockroach start-single-node` URL works identically for dev.
COCKROACH_URL=postgresql://<user>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full

# AWS Bedrock — embeddings (Titan v2, in embed.py) + reasoning (Converse, in decide.py).
AWS_REGION=us-east-1
# Reasoning model for decide.py. Nova Micro is cheap/free-tier-friendly; any Bedrock
# Converse model works (deepseek.r1-v1:0, us.anthropic.claude-haiku-4-5-...). Some
# models need a geo prefix (us./eu./apac.) for on-demand — decide.py retries with us.
BEDROCK_REASONING_MODEL=amazon.nova-micro-v1:0

# Match threshold (cosine distance): a pattern matches when distance <= this.
# Calibrated against real Titan v2 embeddings (scripts/smoke_test.py --calibrate).
# Safe window is (0.321, 0.593); 0.45 sits mid-window. 0.30 silently breaks the
# dbt cross-system match, so re-run --calibrate if the signatures change.
MATCH_MAX_DISTANCE=0.45
